    <diagram name="モデル選択サイクル" id="cycle">
        <mxGraphModel dx="1422" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
            <root>
                <mxCell id="c0"/>
                <mxCell id="c1" parent="c0"/>
                <mxCell id="cycleTitle" value="モデル選択フレームワーク（AIM311）とこのリポジトリの担当範囲" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="c1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="identify" value="1. Identify（見極める）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D9822B;fontSize=15;fontStyle=1;fontColor=#7A4A12;verticalAlign=top;spacingTop=8;" vertex="1" parent="c1">
                    <mxGeometry x="60" y="90" width="300" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="identifyBody" value="・モダリティ（テキスト / 画像 / 音声）で候補を絞る&lt;br&gt;・公開ベンチマークで品質・コスト・レイテンシを比較&lt;br&gt;・コンテキスト長やマルチモーダル対応を確認&lt;br&gt;&lt;br&gt;&lt;i&gt;このリポジトリの対象外（手作業で決める）&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#5C3A10;" vertex="1" parent="c1">
                    <mxGeometry x="75" y="125" width="275" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="evaluate" value="2. Evaluate（評価する）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;strokeWidth=3;fontSize=15;fontStyle=1;fontColor=#04564A;verticalAlign=top;spacingTop=8;" vertex="1" parent="c1">
                    <mxGeometry x="430" y="90" width="330" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="evaluateBody" value="・ゴールデンデータセット（質問 + 期待回答）を作る&lt;br&gt;・評価基準ファイルを人間が管理する&lt;br&gt;・プログラマティック / 人間 / LLM-as-a-Judge で採点&lt;br&gt;・品質メトリクスと運用メトリクスを両方見る&lt;br&gt;&lt;br&gt;&lt;b&gt;このリポジトリがカバーする範囲&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#04564A;" vertex="1" parent="c1">
                    <mxGeometry x="445" y="125" width="305" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="optimize" value="3. Optimize（最適化する）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4FA8;fontSize=15;fontStyle=1;fontColor=#3D2A66;verticalAlign=top;spacingTop=8;" vertex="1" parent="c1">
                    <mxGeometry x="830" y="90" width="280" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="optimizeBody" value="・モデルカスタマイズ（ファインチューニング）&lt;br&gt;・プロンプトキャッシング&lt;br&gt;・推論ティアの調整&lt;br&gt;&lt;br&gt;&lt;i&gt;改善したら Evaluate に戻って定量的に確認する&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#3D2A66;" vertex="1" parent="c1">
                    <mxGeometry x="845" y="125" width="255" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="c1" source="identify" target="evaluate">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#232F3E;strokeWidth=2;" edge="1" parent="c1" source="evaluate" target="optimize">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce3" value="新モデルの登場・要件変更があれば Identify に戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;strokeColor=#232F3E;strokeWidth=2;dashed=1;fontSize=12;fontColor=#232F3E;verticalAlign=bottom;" edge="1" parent="c1" source="optimize" target="identify">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="970" y="60"/>
                            <mxPoint x="210" y="60"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="stepTitle" value="Evaluate の内訳（このリポジトリの処理順）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="c1">
                    <mxGeometry x="60" y="330" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="① 生成条件を入力&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;ユースケース・ペルソナ・評価基準&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=12;fontColor=#233B5C;" vertex="1" parent="c1">
                    <mxGeometry x="60" y="380" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="② 候補データを生成&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;標準 / エッジ / 安全性の3カテゴリ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontSize=12;fontColor=#233B5C;" vertex="1" parent="c1">
                    <mxGeometry x="290" y="380" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="③ 人間がレビュー&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;期待回答を実際の正解に書き換えて承認&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF7;strokeColor=#4A6FA5;strokeWidth=2;fontSize=12;fontColor=#233B5C;" vertex="1" parent="c1">
                    <mxGeometry x="520" y="380" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="④ 検証と整形&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;prepare.mjs が重複や形式崩れで止める&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4FA8;fontSize=12;fontColor=#3D2A66;" vertex="1" parent="c1">
                    <mxGeometry x="750" y="380" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="⑤ 評価ジョブを投入&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;submit.sh が S3 配置とジョブ作成を行う&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6B4FA8;fontSize=12;fontColor=#3D2A66;" vertex="1" parent="c1">
                    <mxGeometry x="980" y="380" width="190" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s6" value="⑥ スコアを比較して採用モデルを決める&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;fetch-results.sh で結果を取得し、品質と運用コストの両面で判断する&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;fontSize=12;fontColor=#04564A;" vertex="1" parent="c1">
                    <mxGeometry x="60" y="500" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A6FA5;" edge="1" parent="c1" source="s1" target="s2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A6FA5;" edge="1" parent="c1" source="s2" target="s3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A6FA5;" edge="1" parent="c1" source="s3" target="s4">
